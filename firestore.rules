rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Default deny for arbitrary collections
    match /{document=**} {
      allow read, write: if false;
    }

    // Matrimonial biodata profiles: public can view, authorized updates persist
    match /biodata/{biodataId} {
      allow get: if isValidId(biodataId);
      allow list: if true;
      allow write: if isValidId(biodataId);

      match /photos/{photoId} {
        allow get, list: if isValidId(biodataId) && isValidId(photoId);
        allow write: if isValidId(biodataId) && isValidId(photoId);
      }
    }

    // Admins registry
    match /admins/{adminId} {
      allow get: if isValidId(adminId);
      allow list: if false;
      allow write: if false;
    }
  }
}
